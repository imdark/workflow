<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.workflow.monitor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/workflow/workflow/monitor_service.py</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/workflow-monitor.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/workflow-monitor-error.log</string>
    <key>WorkingDirectory</key>
    <string>/opt/workflow</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>/opt/workflow</string>
    </dict>
</dict>
</plist>